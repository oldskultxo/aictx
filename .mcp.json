{
  "_aictx": {
    "block": "<AICTX>",
    "kind": "aictx-managed",
    "managed": true
  },
  "mcpServers": {
    "aictx": {
      "_aictx_block": "<AICTX>",
      "_aictx_managed": true,
      "args": [
        "-m",
        "aictx",
        "mcp-server",
        "--repo",
        ".",
        "--profile",
        "full"
      ],
      "command": ".venv/bin/python",
      "cwd": ".",
      "env": {
        "PYTHONPATH": "src"
      },
      "transport": "stdio",
      "type": "stdio"
    }
  }
}
